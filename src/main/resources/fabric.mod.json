{
	"schemaVersion": 1,
	"id": "sockchat",
	"version": "${version}",
	"name": "SockChat",
	"description": "Sends chat messages received over a local TCP socket.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/sockchat/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"name.modid.Sockchat"
		],
		"client": [
			"name.modid.client.SockchatClient"
		],
		"fabric-datagen": [
			"name.modid.client.SockchatDataGenerator"
		]
	},
	"mixins": [
		"sockchat.mixins.json",
		{
			"config": "sockchat.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*"
	}
}